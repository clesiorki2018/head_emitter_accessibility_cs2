# Local ESP-IDF setup.
ESP_IDF_PATH=/home/max/projetos/esp/esp-idf
ESPPORT=

# Receiver identity.
HEAD_CLICK_RECEIVER_WIFI_STA_MAC=---

# Shared ESP-NOW radio and security settings.
HEAD_CLICK_ESP_NOW_WIFI_CHANNEL=6
HEAD_CLICK_ESP_NOW_ENCRYPTION_ENABLED=1
HEAD_CLICK_ESP_NOW_PMK_HEX=

# Future application authentication settings.
HEAD_CLICK_APP_AUTH_KEY_HEX=
HEAD_CLICK_APP_REPLAY_PROTECTION_ENABLED=1
HEAD_CLICK_APP_SEQUENCE_WINDOW=32

# Combo sender identity.
HEAD_CLICK_SENDER_COMBO_NAME=combo
HEAD_CLICK_SENDER_COMBO_ENABLED=1
HEAD_CLICK_SENDER_COMBO_CAPABILITIES=mouse,keyboard,joystick
HEAD_CLICK_SENDER_COMBO_LMK_HEX=
